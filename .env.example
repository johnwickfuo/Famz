# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# APP_NAME is a PLACEHOLDER ONLY. It is the last-resort fallback used by
# BrandingService when the `company_name` setting has not been filled in yet.
# The real company name is entered by the admin in /admin -> Settings and is
# stored in the `settings` table. Never hardcode a client name anywhere.
APP_NAME="Agri Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agriplatform
DB_USERNAME=agriplatform
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Redis — cache, queue and session
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=agriplatform_database_

CACHE_STORE=redis
CACHE_PREFIX=agriplatform_cache_

QUEUE_CONNECTION=redis
REDIS_QUEUE=default

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

MEMCACHED_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Session security
# ---------------------------------------------------------------------------
# All three MUST stay at these values in production. SESSION_SECURE_COOKIE
# false on an https site means the session cookie is sent over plain http too,
# which is one downgrade away from somebody else's account. Set it to false
# only on a local http development machine.
# Leave unset and the cookie name is derived from APP_NAME. Set it explicitly
# when another application shares this domain, or the two will overwrite each
# other's sessions and log people out at random.
SESSION_COOKIE=

SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Local development: Mailpit (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit)
# Production: pick ONE transactional provider below and set MAIL_MAILER to it.
# Do NOT relay platform mail through the VPS's own SMTP — deliverability to
# Gmail and Yahoo will be poor.
MAIL_MAILER=mailpit
MAIL_FROM_ADDRESS="no-reply@example.test"
# Leave MAIL_FROM_NAME unset: the from-name is resolved at send time from the
# `company_name` setting via BrandingService.
MAIL_FROM_NAME=

# SMTP, when the provider is used over SMTP rather than its API. Every
# provider below also offers SMTP; the API drivers are preferred because they
# report a bounce as a rejection rather than accepting the message and
# discarding it.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Mailpit (local only)
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

# --- Resend --- MAIL_MAILER=resend
RESEND_KEY=

# --- Postmark --- MAIL_MAILER=postmark
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=outbound

# --- Brevo --- MAIL_MAILER=brevo
BREVO_KEY=

# --- Mailgun --- MAIL_MAILER=mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Address that receives "send test email" previews from the admin panel.
MAIL_TEST_RECIPIENT=

# Bounce and complaint webhook. Register this URL with the provider:
#
#   https://your-domain/webhooks/mail/<provider>?token=<this value>
#
# where <provider> is resend, postmark, brevo or mailgun. A hard bounce or a
# spam complaint suppresses the address so the queue stops retrying it — which
# matters because the provider scores the whole platform on how much of its
# mail bounces, and that score decides whether a seller's order notification
# reaches an inbox at all.
#
# Leave empty and the endpoint refuses everything: an open suppression endpoint
# would let anybody stop the platform writing to a rival seller.
MAIL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Super administrator — seeded by database/seeders/SuperAdminSeeder.php
# ---------------------------------------------------------------------------
SUPER_ADMIN_NAME="Platform Administrator"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Which gateway is actually used is an admin setting, not configuration.
# Fill in the credentials for whichever you switch on, and register the
# webhook URL below with them — the order only moves when that webhook lands.
#
#   Paystack:     https://your-domain/webhooks/payments/paystack
#   Flutterwave:  https://your-domain/webhooks/payments/flutterwave
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Flutterwave verifies webhooks with a shared secret in a header rather than
# by signing the body. Set the same value in their dashboard.
FLUTTERWAVE_WEBHOOK_HASH=

# ---------------------------------------------------------------------------
# Object storage (optional)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The AI layer used to map a client's description onto mentor specialisation
# tags. Entirely optional: with no key, matching falls back to keywords and
# nothing stops working.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Gateway and AI endpoints
# ---------------------------------------------------------------------------
# Overridable so a staging deployment can be pointed at a sandbox, and so a
# test can point them at a local stub. Leave unset in production.
PAYSTACK_BASE_URL=
FLUTTERWAVE_BASE_URL=
GEMINI_BASE_URL=

# ---------------------------------------------------------------------------
# Branding assets
# ---------------------------------------------------------------------------
# Where the logo and favicon uploaded from the settings screen are kept. The
# defaults put them on the public disk under `branding/`. Point BRANDING_DISK
# at s3 if the application runs on more than one server, or the logo will
# exist on whichever machine handled the upload and nowhere else.
BRANDING_DISK=public
BRANDING_DIRECTORY=branding

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
# BACKUP_DISK must be OFF the server being backed up. A backup on the same
# disk as the database survives a mistake and does not survive the disk. Any
# configured filesystem disk works; `s3` is the usual answer.
BACKUP_DISK=s3
# Encrypts the archive. Set it, and keep it somewhere other than this server —
# an encrypted backup whose password is only on the dead machine is not a
# backup.
BACKUP_ARCHIVE_PASSWORD=

# ---------------------------------------------------------------------------
# Error tracking and monitoring
# ---------------------------------------------------------------------------
# With no DSN the Sentry integration is inert, so a development machine and a
# CI run report nothing while production reports everything.
SENTRY_LARAVEL_DSN=
# The share of requests traced for performance. 0.0 disables it; 1.0 traces
# every request and will exhaust a small quota in a day.
SENTRY_TRACES_SAMPLE_RATE=0.1

# /health answers "ok" or "degraded" to anybody, which is all an uptime
# monitor needs. Pass ?token= this value to also get which dependency is
# failing. Leave empty and that detail is never shown.
HEALTH_CHECK_TOKEN=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# How many days of rotated log to keep. The reconciliation channel ignores
# this and keeps a year: "when did the books first disagree" has to still have
# an answer.
LOG_DAILY_DAYS=14
