# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# APP_NAME is a PLACEHOLDER ONLY. It is the last-resort fallback used by
# BrandingService when the `company_name` setting has not been filled in yet.
# The real company name is entered by the admin in /admin -> Settings and is
# stored in the `settings` table. Never hardcode a client name anywhere.
APP_NAME="Agri Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agriplatform
DB_USERNAME=agriplatform
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Redis — cache, queue and session
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=agriplatform_database_

CACHE_STORE=redis
CACHE_PREFIX=agriplatform_cache_

QUEUE_CONNECTION=redis
REDIS_QUEUE=default

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

MEMCACHED_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Local development: Mailpit (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit)
# Production: pick ONE transactional provider below and set MAIL_MAILER to it.
# Do NOT relay platform mail through the VPS's own SMTP — deliverability to
# Gmail and Yahoo will be poor.
MAIL_MAILER=mailpit
MAIL_FROM_ADDRESS="no-reply@example.test"
# Leave MAIL_FROM_NAME unset: the from-name is resolved at send time from the
# `company_name` setting via BrandingService.
MAIL_FROM_NAME=

# Mailpit (local only)
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

# --- Resend --- MAIL_MAILER=resend
RESEND_KEY=

# --- Postmark --- MAIL_MAILER=postmark
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=outbound

# --- Brevo --- MAIL_MAILER=brevo
BREVO_KEY=

# --- Mailgun --- MAIL_MAILER=mailgun
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Address that receives "send test email" previews from the admin panel.
MAIL_TEST_RECIPIENT=

# ---------------------------------------------------------------------------
# Super administrator — seeded by database/seeders/SuperAdminSeeder.php
# ---------------------------------------------------------------------------
SUPER_ADMIN_NAME="Platform Administrator"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Object storage (optional)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
